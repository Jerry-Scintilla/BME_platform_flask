MySQL访问凭据
DB_USERNAME=XXXXXXXXXXX
DB_PASSWORD=XXXXXXXXXXX

Redis访问凭据
REDIS_URL=XXXXXXXXXXX

JWT密钥
# JWT 签名密钥：>=32 字符随机串（缺失或过短拒绝启动）
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CORS 来源白名单（逗号分隔，含协议与端口；不配置=全放行+启动警告，上线必须配）
# 例：CORS_ORIGINS=https://xxx.example.edu.cn,http://127.0.0.1:8081,http://127.0.0.1:5173
CORS_ORIGINS=

邮箱服务器
EMAIL_SERVER=XXXXXXXXXXX
MAIL_USERNAME=XXXXXXXXXXX
MAIL_PASSWORD=XXXXXXXXXXX

人脸签到凭证
FACE_SECRET=XXXXXXXXXXX

LiteLLM 大模型代理（外部已部署）
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-XXXXXXXXXXX
LITELLM_DEFAULT_MAX_BUDGET=5
LITELLM_DEFAULT_BUDGET_DURATION=30d

# 每日出勤报告（收件人由 RBAC 权限 attendance_report.recipient 管理）
ATTENDANCE_REPORT_ENABLED=true
ATTENDANCE_REPORT_TIMEZONE=Asia/Shanghai

# 对象存储（课程资源/营期材料附件）
# minio = S3 兼容对象存储 | local = 本地磁盘（附件仓库在 {DATA_ROOT}/storage 下，无需 MinIO 服务）
STORAGE_BACKEND=minio
# 本地文件根目录（头像/文章/作业等；部署时指到数据盘挂载点，避免挤占系统盘）
DATA_ROOT=./data

# STORAGE_BACKEND=minio 时生效
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=XXXXXXXXXXX
MINIO_SECRET_KEY=XXXXXXXXXXX
MINIO_BUCKET=bme-course-resources
MINIO_SECURE=false

# 官方富文本推文（HTML 正文，仅文章管理员；关闭不影响已发布 HTML 文章阅读）
ARTICLE_HTML_ENABLED=true
# 远程图片转存是否放行 http 图源（默认仅 https；SSRF 内网防护始终开启）
ARTICLE_HTML_FETCH_HTTP=false