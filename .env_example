MySQL访问凭据
DB_USERNAME=XXXXXXXXXXX
DB_PASSWORD=XXXXXXXXXXX

Redis访问凭据
REDIS_URL=XXXXXXXXXXX

JWT密钥
# JWT 签名密钥：>=32 字符随机串（缺失或过短拒绝启动）
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CORS 来源白名单（逗号分隔，含协议与端口；不配置=全放行+启动警告，上线必须配）
# 例：CORS_ORIGINS=https://xxx.example.edu.cn,http://127.0.0.1:8081,http://127.0.0.1:5173
CORS_ORIGINS=

邮箱服务器
EMAIL_SERVER=XXXXXXXXXXX
MAIL_USERNAME=XXXXXXXXXXX
MAIL_PASSWORD=XXXXXXXXXXX

人脸签到凭证
FACE_SECRET=XXXXXXXXXXX

LiteLLM 大模型代理（外部已部署）
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-XXXXXXXXXXX
LITELLM_DEFAULT_MAX_BUDGET=5
LITELLM_DEFAULT_BUDGET_DURATION=30d

# 每日出勤报告（收件人由 RBAC 权限 attendance_report.recipient 管理）
ATTENDANCE_REPORT_ENABLED=true
ATTENDANCE_REPORT_TIMEZONE=Asia/Shanghai

# 对象存储（课程资源/营期材料附件）
# minio = S3 兼容对象存储 | local = 本地磁盘（附件仓库在 {DATA_ROOT}/storage 下，无需 MinIO 服务）
STORAGE_BACKEND=minio
# 本地文件根目录（头像/文章/作业等；部署时指到数据盘挂载点，避免挤占系统盘）
DATA_ROOT=./data

# STORAGE_BACKEND=minio 时生效
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=XXXXXXXXXXX
MINIO_SECRET_KEY=XXXXXXXXXXX
MINIO_BUCKET=bme-course-resources
MINIO_SECURE=false

# 官方富文本推文（HTML 正文，仅文章管理员；关闭不影响已发布 HTML 文章阅读）
ARTICLE_HTML_ENABLED=true
# 远程图片转存是否放行 http 图源（默认仅 https；SSRF 内网防护始终开启）
ARTICLE_HTML_FETCH_HTTP=false# 开发测试账号面板（/auth/dev_accounts，登录页快捷登录数据源）：debug 模式自动可用，
# 非 debug 显式开启用（生产不设即关）。账号约定见 README 开发测试账号节
DEV_TEST_ACCOUNTS=on

# ── D1 身份安全地基（migrate_62，成员身份确认与重复账号安全迁移）──
# refresh 迁 HttpOnly cookie 总开关（默认关=兼容模式，响应体仍返回 refresh_token）
AUTH_REFRESH_COOKIE_ENABLED=false
# cookie Secure 属性（生产 https 置 true；dev http://127.0.0.1 默认 false）
AUTH_COOKIE_SECURE=false
# 旧协议 token 兼容截止（ISO 日期时间，Asia/Shanghai）；生产必须显式固定，
# 不设则每次启动顺延为「启动+14 天」并打告警。示例：
# AUTH_LEGACY_TOKEN_DEADLINE=2026-11-01T00:00:00
# 高风险操作近期认证窗口（秒，默认 300）
AUTH_RECENT_AUTH_SECONDS=300
# 挑战摘要 HMAC 密钥（验证码/恢复码/refresh 摘要用；不设由 JWT_SECRET 派生）
# CHALLENGE_HMAC_SECRET=
# 媒体短签独立密钥（不设回退 JWT_SECRET 并告警）
# MEDIA_SIGN_SECRET=
# MFA 因子加密密钥（Fernet key）：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENC_SECRET=
# 管理端 MFA 强制（默认关；置 true 需先配 MFA_ENC_SECRET，且 /admin/* 会话须含 totp 因子）
MFA_ENFORCE_FOR_ADMIN=false

# ── D3 身份核验与认领（migrate_64，规格 13.1 开关拆开）──
# UI 总入口（默认关；随 D4 前端一起开。关=停新入口，已提交申请仍可查询）
IDENTITY_UI_ENABLED=false
# 核验通道（默认关。关=停新申请/新挑战，不撤销已核验结果）
IDENTITY_VERIFICATION_ENABLED=false
# 双账号认领提交通道（默认关。关=停新案例；已建案例可查询）
ACCOUNT_LINK_APPLY_ENABLED=false
