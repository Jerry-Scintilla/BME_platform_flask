# LiteLLM Proxy 配置模板（AI 每日资讯助手用）——入库示例，不含任何真实密钥
#
# 用法：复制为 litellm_proxy_config.yaml（真实配置已 gitignore，仅本地生效）。
# 密钥一律走环境变量，绝不写进 yaml：
#   1. .env 中准备 DEEPSEEK_API_KEY / LITELLM_MASTER_KEY
#   2. 启动（BME_platform_flask 目录）：
#      set -a && source .env && set +a
#      .litellm_venv/bin/litellm --config litellm_proxy_config.yaml --port 4000
#
# BME 应用对 {LITELLM_BASE_URL}/chat/completions 发 OpenAI 兼容请求，
# model 参数传 deepseek-chat（即下方 model_name），proxy 路由到 deepseek/deepseek-chat。

model_list:
  - model_name: deepseek-chat
    litellm_params:
      model: deepseek/deepseek-chat
      api_key: os.environ/DEEPSEEK_API_KEY

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
